rules_version = '2';

// Firestore security rules for Brthday Clothing.
// The app only uses users/{uid} (AccountView reads and updates "username").
// Each signed-in user can read and write only their own document; everything else is denied.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules → Publish)
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, create, update: if request.auth != null
                                  && request.auth.uid == userId;
      allow delete: if false;
    }

    // Deny anything not explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
